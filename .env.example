# Copiar a .env y completar antes de correr el proyecto

# Base de datos
DATABASE_URL=postgresql://user:password@host:5432/colonia_crm_dev

# API
PORT=3001
BETTER_AUTH_SECRET=

# Redis (jobs: WhatsApp, email, scraping, recordatorios de pago)
REDIS_URL=redis://localhost:6379

# IA — enriquecimiento de leads
ANTHROPIC_API_KEY=

# Scraping de prospección
GOOGLE_MAPS_API_KEY=

# Email corporativo (IMAP/SMTP genérico)
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=

# WhatsApp — ver apps/whatsapp/.env.example
WHATSAPP_SERVICE_URL=http://localhost:3002
WHATSAPP_INTERNAL_SECRET=
